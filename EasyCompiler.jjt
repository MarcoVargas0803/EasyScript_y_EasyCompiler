
options {
  IGNORE_CASE = false; // EasyScript distingue entre mayúsculas y minúsculas para sus variables y Constantes.
  STATIC = false;

  /* ---------------------------------------------------------------
     Opciones de JJTree (construcción automática del árbol sintáctico)
     --------------------------------------------------------------- */
  MULTI = true;              // Una clase por nodo (ASTPrograma, ASTAsignacion, ...): visitor tipado.
  NODE_DEFAULT_VOID = false; // Crea un nodo por cada producción sin necesidad de anotarlas.
  TRACK_TOKENS = true;       // Cada nodo guarda su rango [primerToken .. ultimoToken].
  VISITOR = true;            // Genera EasyCompilerVisitor y jjtAccept(): la fase semantica es una pasada aparte.
  NODE_CLASS = "NodoEasy";   // Superclase escrita a mano donde viven los campos de decoracion del AST.
}

//Inicia el parser.
PARSER_BEGIN(EasyCompiler)

import java.util.ArrayList;  // Agregado para usar listas dinámicas
import java.util.List;       // Agregado para usar listas dinámicas

public class EasyCompiler {
  // Declaramos la lista de forma estática para que la clase Main pueda imprimirla al final
    public static List<ErrorCompilador> listaErrores = new ArrayList<ErrorCompilador>(); // Tipo explicito: el parser de Java de JJTree no admite el operador diamante <>

    // Se enciende cuando el catch de la regla raiz aborta el analisis: el arbol
    // sintactico queda incompleto y Main debe advertirlo al imprimirlo.
    public static boolean arbolParcial = false;

    // Tokens de sincronización para inicio de sentencias
    static final int[] SYNC_SENTENCIAS = {
        ENTERO_DATO, DECIMAL_DATO, BOOLEANO_DATO, CARACTER_DATO, TEXTO_DATO, 
        ARREGLO_ESTRUCTURA, MATRIZ_ESTRUCTURA, IMPRIMIR_FUNCION, LEER_FUNCION, 
        SI_CONDICIONAL, SEGUN_CONDICIONAL, PARA_CICLO, MIENTRAS_CICLO,
        ABRIR_LLAVE // Token para evitar que llaves huérfanas rompan el programa
    };

// -----------------------------------------------------------------------
    // MÉTODO AUXILIAR 1: Extrae línea y columna del token problemático de forma
    // segura. e.currentToken.next puede ser null y provocar NullPointerException.
    // -----------------------------------------------------------------------
    private static int[] obtenerPosicion(ParseException e) {
        Token t = (e.currentToken != null && e.currentToken.next != null)
                ? e.currentToken.next
                : e.currentToken;
        // Si por alguna razón ambos son null devolvemos -1 para evitar crash
        if (t == null) return new int[]{-1, -1};
        return new int[]{t.beginLine, t.beginColumn};
    }


    // -----------------------------------------------------------------------
    // MÉTODO AUXILIAR 2.1: Recuperación de pánico con Sync Tokens
    // -----------------------------------------------------------------------
    private void recuperarHastaSync(int... syncTokens) {
        Token t = getToken(1);
        while (t.kind != EOF) {
            boolean encontrado = false;
            for (int st : syncTokens) {
                if (t.kind == st) {
                    encontrado = true;
                    break;
                }
            }
            if (encontrado || t.kind == CERRAR_LLAVE || t.kind == PUNTO_COMA) {
                break;
            }
            getNextToken();
            t = getToken(1);
        }
        
        // Si nos detuvimos en un punto y coma, lo consumimos para limpiar la sentencia.
        if (getToken(1).kind == PUNTO_COMA) {
            getNextToken();
        }
    }
	// -----------------------------------------------------------------------
    // MÉTODO AUXILIAR 3: Extrae qué token falló y qué tokens se esperaban.
    // -----------------------------------------------------------------------
        private static String obtenerDetalleSintactico(ParseException e) {
            if (e.currentToken == null || e.currentToken.next == null) return "Error de sintaxis desconocido.";

            // 1. Obtenemos lo que el compilador leyó por error
            String tokenEncontrado = e.currentToken.next.image;
            if (e.currentToken.next.kind == EOF) {
                tokenEncontrado = "Fin del archivo";
            }

            // 2. Extraemos lo que JavaCC estaba esperando
            StringBuilder tokensEsperados = new StringBuilder();
            int maxSize = 0;

            // JavaCC guarda las expectativas en un arreglo 2D
            for (int i = 0; i < e.expectedTokenSequences.length; i++) {
                if (maxSize < e.expectedTokenSequences[i].length) {
                    maxSize = e.expectedTokenSequences[i].length;
                }
                for (int j = 0; j < e.expectedTokenSequences[i].length; j++) {
                    // tokenImage traduce el ID del token a su texto real (ej. ";" o "<VARIABLE>")
                    tokensEsperados.append(e.tokenImage[e.expectedTokenSequences[i][j]]).append(" ");
                }
                if (i < e.expectedTokenSequences.length - 1) {
                    tokensEsperados.append(" o ");
                }
            }

            // Limpiamos las comillas extrañas que pone JavaCC por defecto
            String esperadosStr = tokensEsperados.toString().replace("\"", "");

            return "Se encontró '" + tokenEncontrado + "', pero se esperaba: " + esperadosStr;
        }

    // -----------------------------------------------------------------------
    // MÉTODO AUXILIAR 4: Reconstruye el texto fuente comprendido entre dos tokens.
    // Lo usan las acciones semánticas de las declaraciones para guardar en la
    // tabla de símbolos el valor con el que se inicializó el identificador.
    // -----------------------------------------------------------------------
    private String textoEntre(Token ini, Token fin) {
        if (ini == null || fin == null) return "-";
        StringBuilder sb = new StringBuilder();
        Token t = ini;
        Token previo = null;
        int limite = 0;
        while (t != null && limite < 40) {
            if (previo != null) {
                // Reproducimos el espaciado del código fuente: solo separamos si
                // realmente había un espacio entre ambos tokens. Así "-10" se
                // guarda como "-10" y no como "- 10".
                if (t.beginLine != previo.endLine || t.beginColumn > previo.endColumn + 1) {
                    sb.append(" ");
                }
            }
            sb.append(t.image);
            if (t == fin) break;
            previo = t;
            t = t.next;
            limite++;
        }
        return sb.length() == 0 ? "-" : sb.toString();
    }

        private void agregarError(String tipo, Token token, String mensaje, String sugerencia) {
            if (token != null) {
                EasyCompiler.listaErrores.add(new ErrorCompilador(tipo, token.beginLine, token.beginColumn, mensaje, sugerencia));
            } else {
                EasyCompiler.listaErrores.add(new ErrorCompilador(tipo, -1, -1, mensaje, sugerencia));
            }
        }
    }

PARSER_END(EasyCompiler)

/* Análisis Léxico */

SKIP : {
  " " | "\t" | "\n" | "\r"
  | < COMENTARIO_LINEA: "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n") > // Ignora todo después de // hasta el salto de línea.
  | "/*" : IN_COMMENT
}

<IN_COMMENT> SKIP : {
  "*/" : DEFAULT
  | < ~[] > // Consume cualquier otro carácter dentro del comentario
}

<*> TOKEN : {
  <EOF> {
    if (curLexState == IN_COMMENT) {
        EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", input_stream.getEndLine(), input_stream.getEndColumn(),
            "Comentario de bloque sin cerrar",
            "Asegúrate de cerrar el comentario con '*/' antes del fin del archivo."));
    }
  }
}

//Tokens Principales

TOKEN : {
    //Flujo del programa
  < INICIO_PROGRAMA: "INICIO" >
| < FIN_PROGRAMA: "FIN" >

  // Tipos de datos y estructuras de datos
| < ENTERO_DATO: "ENT" >
| < DECIMAL_DATO: "DEC" >
| < BOOLEANO_DATO: "BOOL" >
| < CARACTER_DATO: "LETRA" >
| < TEXTO_DATO: "TXT" >
| < ARREGLO_ESTRUCTURA: "ARREGLO" >
| < MATRIZ_ESTRUCTURA: "MATRIZ" >

  //Booleanos
| <VERDADERO_BOOLEANO: "VERDADERO">
| <FALSO_BOOLEANO: "FALSO">

  // Condicionales y Ciclos
| < SI_CONDICIONAL: "SI" >
| < SI_CONTRARIO: "CONTRARIO" >
| < SI_SINO: "SINO" >
| < SEGUN_CONDICIONAL: "SEGUN" >
| < CASO_SEGUN: "CASO" >
| < DEFECTO_SEGUN: "DEFECTO" >
| < DETENER_SEGUN: "DETENER" >
| < PARA_CICLO: "PARA" >
| < MIENTRAS_CICLO: "MIENTRAS" >

  // Entrada y Salida
| < LEER_FUNCION: "LEER" >
| < IMPRIMIR_FUNCION: "IMPRIMIR" >
}

// Operadores reservados y delimitadores

TOKEN : {
  // Operadores de Incremento y Decremento
  < INCREMENTO_AL_VALOR: "++" >
| < DECREMENTO_AL_VALOR: "--" >

  // Operadores Aritméticos
| < SUMA: "+" >
| < RESTA: "-" >
| < MULTIPLICACION: "*" >
| < DIVISION: "/" >

  // Operadores Adicionales
| < MODULO: "%" >
| < EXPONENTE: "**" >

// Operadores de comparación
| < IGUAL_ASIGNACION: "=" >
| < IGUAL_COMPARACION: "==" >
| < DIFERENTE: "!=" >
| < MENOR: "<" >
| < MENOR_IGUAL: "<=" >
| < MAYOR: ">" >
| < MAYOR_IGUAL: ">=" >

// Operadores Lógicos
| < Y_LOGICO: "&&" >
| < O_LOGICO: "||" >
| < NO_LOGICO: "!!" >

  // Delimitadores
| < ABRIR_LLAVE: "{" >
| < CERRAR_LLAVE: "}" >
| < ABRIR_PARENTESIS: "(" >
| < CERRAR_PARENTESIS: ")" >
| < ABRIR_CORCHETE: "[" >
| < CERRAR_CORCHETE: "]" >
| < COMA: "," >
| < DOS_PUNTOS: ":" >
| < PUNTO_COMA: ";" >
}

// Expresiones Regulares para Variables, Constantes, Cadenas y Caracteres.

TOKEN : {

  // Variables: Inician con mayúscula, y el resto ESTRICTAMENTE minúsculas, números o guion bajo
  < VARIABLE: ["A"-"Z", "Á","É","Í","Ó","Ú","Ñ"] (["a"-"z", "0"-"9", "_", "á","é","í","ó","ú","ñ"])* >

  // Constantes: Inician con CONST_ seguido de la estructura de variable
| < CONSTANTE: "CONST_" ["A"-"Z", "Á","É","Í","Ó","Ú","Ñ"] (["a"-"z", "0"-"9", "_", "á","é","í","ó","ú","ñ"])* >

  // Números: Enteros y Decimales
| < NUM_ENTERO: (["0"-"9"])+ >
| < NUM_DECIMAL: ( (["0"-"9"])+ "." (["0"-"9"])+ ) | ( "." (["0"-"9"])+ ) >


  // Cadenas de texto: Todo lo que esté entre comillas dobles
| < CADENA: "\"" ( (~["\"","\\","\n","\r"]) // Acepta cualquier carácter normal excepto comillas, barras invertidas o saltos de línea físicos.
                 | ("\\" ["n","t","r","\\","\""]) // <-- O acepta secuencias de escape.
                 )* "\"" >

  // Caracteres: Todo lo que esté entre comillas simples, pero solo un carácter válido o una secuencia de escape
|  < VALOR_LETRA: "'" ["a"-"z", "A"-"Z", "0"-"9"] "'" >

   /* ERRORES LÉXICOS */

    // 1. Cadena de texto no cerrada
|  < ERROR_TEXTO: "\"" (~["\"","\n","\r"])* >

    // 2. Carácter no cerrado con comillas simples
| < ERROR_CARACTER: "'" (~["'","\n","\r"])* >

    // 3. Formato de número decimal inválido
| < ERROR_NUMERO_INVALIDO: (["0"-"9"])+ "." (["0"-"9"])+ ("." (["0"-"9"])+)+ >

    // 4. Identificador inválido
    // Atrapa identificadores que comienzan con número. ejemplo 9numero.
    // O que comienzan con minúscula. ejemplo: numero.
    // O que tengan más de una letra en mayuscula. ejemplo: PrimerNumero.
  | < ERROR_IDENTIFICADOR_INVALIDO:
        ( ["0"-"9"] (["a"-"z", "A"-"Z", "0"-"9", "_", "á","é","í","ó","ú","Á","É","Í","Ó","Ú","ñ","Ñ"])+ )
      | ( ["a"-"z", "á","é","í","ó","ú","ñ"] (["a"-"z", "A"-"Z", "0"-"9", "_", "á","é","í","ó","ú","Á","É","Í","Ó","Ú","ñ","Ñ"])* )
      | ( ["A"-"Z", "Á","É","Í","Ó","Ú","Ñ"] (["a"-"z", "0"-"9", "_", "á","é","í","ó","ú","ñ"])* ["A"-"Z", "Á","É","Í","Ó","Ú","Ñ"] (["a"-"z", "A"-"Z", "0"-"9", "_", "á","é","í","ó","ú","Á","É","Í","Ó","Ú","ñ","Ñ"])* )
    >

    // 5. Carácter con longitud invalida o caracter no definido
  | < ERROR_LONGITUD_CARACTER: "'" (~["'","\n","\r"])* "'" >

    // 6. Operadores lógicos incompletos (Separados por su función)
      | < ERROR_LOGICO_INCOMPLETO: "&" | "|" >
      | < ERROR_NEGACION_INCOMPLETA: "!" >

}

// Manejo de error: Cualquier simbolo fuera del lenguaje.

SKIP: {

  // 7. Símbolo no válido en el lenguaje
 < ERROR_SIMBOLO: ~[] >
  {
        // Acción Léxica: Esto se ejecuta al instante
        EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", input_stream.getEndLine(), input_stream.getEndColumn(),
                            "Simbolo no valido '" + image.toString() + "'",
                            "Usa la simbologia definida en el manual de usuario."));
    }


}


/* Análisis Sintactico */

// Sentencias adentro del los Tokens INICIO Y FIN.
void Sentencias() :
{}
{
    // Cada par de llaves es un ambito. Abrirlo y cerrarlo ya NO se hace aqui:
    // lo hace AnalizadorSemantico.visit(ASTSentencias), que recorre el arbol en
    // este mismo orden y por tanto reconstruye la misma anidacion.
    //
    // El motivo de haberlo movido: si los ambitos se abren y cierran durante el
    // parseo, cuando el arbol esta completo la pila ya esta vacia y
    // TablaSimbolos.buscar() no encuentra nada. Haciendolo en el visitor, la
    // pila esta viva justo cuando hay que resolver los nombres.
    (
         DeclaracionVariable()
      |  DeclaracionArreglo()
      |  DeclaracionMatriz()
      | Asignacion()
      | Imprimir()
      | Leer()
      | CondicionalSi()
      | CondicionalSegun()
      | BuclePara()
      | BucleMientras()
      | BloqueAnonimo()
       /*
        Bloque anónimo para atrapar llaves de estructuras de control que fallaron
        y evitar que desbalanceen las llaves de todo el programa.
       */
      | <PUNTO_COMA>
      //Sentencia Vacia: Solo un punto y coma, para permitir sentencias vacías sin romper el programa.
    )*
}

// Bloque anónimo para recuperación de errores
void BloqueAnonimo() :
{}
{
    <ABRIR_LLAVE> Sentencias() <CERRAR_LLAVE>
}

SimpleNode Programa() :
{}
{
  try{
    <INICIO_PROGRAMA>
    <ABRIR_LLAVE>

    Sentencias() 
    
    <CERRAR_LLAVE>
    <FIN_PROGRAMA>
    <EOF>
  }catch(ParseException e){
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);

        String consejo = "Todo código debe comenzar con INICIO { y terminar con } FIN.";
        
        Token errToken = e.currentToken != null ? e.currentToken.next : null;
        if (errToken != null) {
            if (errToken.kind == FIN_PROGRAMA) {
                consejo = "¡Cuidado con las llaves! Parece que olvidaste cerrar una llave '}' en alguna estructura interna (como un SI, PARA o MIENTRAS), lo que causó un desbalanceo.";
            } else if (errToken.kind == SI_CONTRARIO || errToken.kind == SI_SINO || errToken.kind == CASO_SEGUN || errToken.kind == DEFECTO_SEGUN) {
                consejo = "Palabra reservada fuera de lugar. Esto suele ocurrir si te faltó cerrar el bloque anterior con '}' o 'DETENER;', o si usaste la palabra de forma aislada.";
            }
        }

        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            consejo));

        // Como es la regla raíz consumimos hasta EOF para no generar más ruido
        arbolParcial = true;
        while (getNextToken().kind != EOF) {}
  }

  // jjtThis es el nodo que JJTree construyo para esta produccion: la raiz del arbol.
  // Va despues del try/catch para devolverse igual cuando hubo error irrecuperable,
  // solo que con los hijos parciales que alcanzo a acumular.
  { return jjtThis; }
}

// ==========================================
// TipoDato: ATRIBUTO SINTETIZADO (Aho, Figura 5.8, pág. 315)
//
// Equivale a las producciones 2 y 3 del libro:
//      T -> int    { T.tipo = integer }
//      T -> float  { T.tipo = float   }
//
// El tipo se calcula en el hijo y SUBE por el valor de retorno. Quien llama a
// esta producción lo recibe y lo HEREDA hacia el identificador, igual que el
// libro pasa T.tipo al atributo L.her en la producción 1: D -> T L.
// ==========================================
String TipoDato() :
{ Token t; }
{
    (
        t = <ENTERO_DATO>
      | t = <DECIMAL_DATO>
      | t = <BOOLEANO_DATO>
      | t = <CARACTER_DATO>
      | t = <TEXTO_DATO>
    )
    { return t.image; }
}

void Valor() :
{
  Token t = null;
  Token err = null;
}
{
    (
        t = <NUM_ENTERO>
      | t = <NUM_DECIMAL>
      | t = <CADENA>
      | t = <VALOR_LETRA>
      | t = <VERDADERO_BOOLEANO>
      | t = <FALSO_BOOLEANO>
      | t = <VARIABLE>
      | t = <CONSTANTE>
    )
    // DECORACION DEL NODO (no es analisis semantico, es informacion lexica).
    // El nodo se queda con el token que lo origino. El analizador semantico lo
    // necesita para tres cosas: saber si es literal o identificador, deducir el
    // tipo del literal, y poder reportar el error en la linea y columna exactas.
    { jjtThis.tokenId = t; }

  
  // Atrapa errores Léxicos
  

  | err = <ERROR_TEXTO>
    {
        // Acción Léxica: Esto se ejecuta al instante
      EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                              "Cadena de texto sin cerrar.",
                              "Cierra la cadena de texto con comillas dobles."));
    }
  | err = <ERROR_CARACTER>
    {
      // Acción Léxica: Esto se ejecuta al instante
      EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                            "Caracter sin cerrar.",
                            "Cierra el caracter con comillas simples."));

    }

  | err = <ERROR_NUMERO_INVALIDO>
  {
          // Acción Léxica: Esto se ejecuta al instante
          EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                              "Formato decimal invalido '" + err.image + "'",
                              "Sigue la regla para decimales. Ejemplo: 3.1416"));
      }

  | err = <ERROR_IDENTIFICADOR_INVALIDO>
  {
          // Acción Léxica: Esto se ejecuta al instante
          EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                              "Identificador no valido '" + err.image + "'",
                              "Toda variable/constante debe iniciar con una mayúscula seguido de minusculas, no debe empezar con números. Ejemplo: 'Variable_1' o 'CONST_Mi_Nombre'"));
      }
  | err = <ERROR_LONGITUD_CARACTER>
  {
          // Acción Léxica: Esto se ejecuta al instante
          EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                              "Formato de caracter invalido: " + err.image,
                              "Longitud mayor a 1 o caracter no reconocido para LETRA. Ejemplos: 'a' o '5'"));
      }
  | err = <ERROR_LOGICO_INCOMPLETO>
  {
          // Acción Léxica: Esto se ejecuta al instante
          EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                              "Operador incompleto o no valido: '" + err.image + "'",
                              "Los operadores en EasyScript son dobles (&&, ||, !!)."));
      }
}

// ==========================================
// JERARQUIA DE EXPRESIONES
//
// Cada nivel es una produccion aparte para fijar la precedencia: Nivel1 suma y
// resta, Nivel2 multiplica, Nivel3 eleva, Nivel4 aplica el menos unario.
//
// Las acciones { } de abajo NO comprueban nada. Solo anotan en el nodo el
// operador que el parser acaba de leer, y hacen falta por una razon concreta:
// JJTree crea un nodo por produccion pero NO convierte los operadores en nodos.
// El '+' de una suma se consume como token suelto dentro del nodo padre y
// desaparece de la lista de hijos. Sin esta anotacion no hay arbol de
// expresiones de verdad (tema 1.1) ni con que comprobar tipos (tema 1.3).
//
// Quien decide sigue siendo AnalizadorSemantico, en su pasada aparte.
// ==========================================
void ExpresionAritmetica() :
{}
{
    ExpresionNivel1()
}

// Nivel 1: suma y resta
void ExpresionNivel1() :
{ Token op; }
{
    ExpresionNivel2()
    (
        ( op = <SUMA> | op = <RESTA> )
        { jjtThis.agregarOperador(op); }
        ExpresionNivel2()
    )*
}

// Nivel 2: multiplicacion, division y modulo
void ExpresionNivel2() :
{ Token op; }
{
    ExpresionNivel3()
    (
        ( op = <MULTIPLICACION> | op = <DIVISION> | op = <MODULO> )
        { jjtThis.agregarOperador(op); }
        ExpresionNivel3()
    )*
}

// Nivel 3: menos unario.
//
// Va ENCIMA del exponente, no debajo. Es lo que hace que -2 ** 2 valga -(2**2)
// y no (-2)**2: el signo se aplica al RESULTADO de la potencia, no a su base.
// Es la convencion de las matematicas y la de casi todos los lenguajes, y es la
// que espera cualquiera que copie una formula a mano.
//
// Antes este nivel estaba debajo del exponente y "-2 ** 2" daba 4.
void ExpresionNivel3() :
{ Token menos = null; }
{
    ( menos = <RESTA> )?
    { jjtThis.unario = (menos != null); jjtThis.agregarOperador(menos); }
    ExpresionNivel4()
}

// Nivel 4: exponente.
//
// Asocia a la DERECHA, y por eso se llama a si mismo en vez de usar un bucle:
// 2**3**2 es 2**(3**2) = 512, no (2**3)**2 = 64. Un (...)* habria agrupado por
// la izquierda, que es lo que hacia antes y daba el resultado equivocado.
//
// El operando derecho vuelve a Nivel3 y no a Nivel4 para que "2 ** -3" siga
// siendo valido: el exponente puede llevar signo aunque la base ya no.
void ExpresionNivel4() :
{ Token op = null; }
{
    ValorConArreglos()
    (
        op = <EXPONENTE>
        { jjtThis.agregarOperador(op); }
        ExpresionNivel3()
    )?
}


// Subnivel para manejar valores, llamadas a arreglos o expresiones entre parentesis
void ValorConArreglos() :
{}
{
    (
        <ABRIR_PARENTESIS> Condicion() 
        (
            <CERRAR_PARENTESIS>
          | {
                Token t = getToken(1);
                EasyCompiler.listaErrores.add(new ErrorCompilador("Sintáctico", t.beginLine, t.beginColumn,
                    "Falta paréntesis de cierre ')'",
                    "Parece que olvidaste cerrar un paréntesis en tu operación."));
            }
        )
        // DECORACION: distingue "(A+B)" de un acceso a arreglo. El analizador
        // semantico lo usa para no confundir un parentesis con un indice.
        { jjtThis.parentizada = true; }
      | 
        Valor()
        // Soporte opcional para acceder a índices de arreglos o matrices
        (
            <ABRIR_CORCHETE> ExpresionAritmetica() 
            (
                <CERRAR_CORCHETE>
              | {
                    Token t = getToken(1);
                    EasyCompiler.listaErrores.add(new ErrorCompilador("Sintáctico", t.beginLine, t.beginColumn,
                        "Falta corchete de cierre ']'",
                        "Parece que olvidaste cerrar el índice del arreglo con ']'."));
                }
            )
            // DECORACION: cuantos indices traia el acceso. 1 = arreglo, 2 = matriz.
            // Es lo unico que permite despues distinguir "A[0]" de "A" a secas.
            { jjtThis.numIndices = 1; }
            ( <ABRIR_CORCHETE> ExpresionAritmetica() 
              (
                  <CERRAR_CORCHETE>
                | {
                      Token t = getToken(1);
                      EasyCompiler.listaErrores.add(new ErrorCompilador("Sintáctico", t.beginLine, t.beginColumn,
                          "Falta corchete de cierre ']'",
                          "Parece que olvidaste cerrar el índice de la matriz con ']'."));
                  }
              ) 
              { jjtThis.numIndices = 2; }
            )?
        )?
    )
}

// ==========================================
// RECUPERACIÓN POR INSERCIÓN
// ==========================================
void PuntoYComaVirtual() :
{}
{
    <PUNTO_COMA>
  | {
        Token t = getToken(1);
        EasyCompiler.listaErrores.add(new ErrorCompilador("Sintáctico", t.beginLine, t.beginColumn,
            "Falta punto y coma ';'",
            "Se esperaba un ';' al final de la instrucción."));
    }
}

// Regla principal para declarar variables
void DeclaracionVariable() :
{
  Token id;                     // id.entrada: el identificador que se instalará
  String tipo = "?";            // L.her: tipo heredado que baja desde TipoDato()
  Token ini = null;             // Primer token de la expresión inicializadora
  boolean inicializada = false;
  String valor = "-";
}
{
    try {
        // El tipo se SINTETIZA aquí y se HEREDA hacia el identificador de abajo.
        tipo = TipoDato()

        ( id = <VARIABLE> | id = <CONSTANTE> | id = <ERROR_IDENTIFICADOR_INVALIDO> )

        {
            // Validamos y guardamos el error léxico sin detener la compilación
            if (id.kind == ERROR_IDENTIFICADOR_INVALIDO) {
                EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", id.beginLine, id.beginColumn,
                    "Identificador no valido '" + id.image + "'.",
                    "Toda variable/constante debe iniciar con una mayúscula seguido de minusculas o guiones bajos, no debe empezar con números. Ejemplo: 'Variable_1' o 'CONST_Mi_Nombre'"));
            }
        }

        (
            <IGUAL_ASIGNACION>
            { ini = getToken(1); }
            Condicion()
            { inicializada = true; valor = textoEntre(ini, getToken(0)); }
        )?

        {
            // DECORACION DEL NODO: se registra lo que el parser acaba de ver,
            // sin interpretarlo. Esto NO es analisis semantico.
            //
            // Hasta ahora aqui vivia la accion que instalaba el simbolo en la
            // tabla: la funcion "agregarTipo" que Aho deja supuesta en la
            // Figura 5.8 (Compiladores, 2a ed., pag. 315). Se movio a
            // AnalizadorSemantico.visit(ASTDeclaracionVariable), para que toda
            // decision semantica ocurra en un mismo sitio y en una sola pasada
            // sobre el arbol. La gramatica solo anota; quien decide es el
            // analizador.
            jjtThis.decorarDeclaracion(id, tipo, inicializada, valor, "-");
        }

        PuntoYComaVirtual()

    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);

        String detalleDinamico = obtenerDetalleSintactico(e);

        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "Asegúrate de definir el tipo de dato, el nombre correctamente y terminar con un punto y coma."));

        // Usamos Sync Tokens para detenernos si vemos el inicio de otra sentencia
        recuperarHastaSync(SYNC_SENTENCIAS);
    }
}

// ==========================================
// DECLARACIÓN DE ARREGLOS
// Ejemplo: ARREGLO ENT Calificaciones[10];
// ==========================================
void DeclaracionArreglo() :
{
  Token id;
  String tipo = "?";            // Tipo base heredado hacia el identificador
  Token ini = null;
  String dim = "[]";            // Dimensión declarada, tal como se escribió
  boolean inicializada = false;
  String valor = "-";
}
{
    try {
        <ARREGLO_ESTRUCTURA> tipo = TipoDato()

        ( id = <VARIABLE> | id = <ERROR_IDENTIFICADOR_INVALIDO> )
        {
            if (id.kind == ERROR_IDENTIFICADOR_INVALIDO) {
                EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", id.beginLine, id.beginColumn,
                    "Identificador no valido '" + id.image + "'.",
                    "Toda variable debe iniciar con mayúscula seguido de minusculas o guiones bajos, no debe empezar con números. Ejemplo: 'Variable_1' o 'CONST_Mi_Nombre'."));
            }
        }

        // El tamaño del arreglo va entre corchetes
        <ABRIR_CORCHETE>
        { ini = getToken(1); }
        ExpresionAritmetica()
        { dim = "[" + textoEntre(ini, getToken(0)) + "]"; }
        <CERRAR_CORCHETE>

        //Inicialización del Arreglo Opcional
        (
        <IGUAL_ASIGNACION>
        { ini = getToken(1); }
        <ABRIR_LLAVE> Condicion() (<COMA> Condicion())* <CERRAR_LLAVE>
        { inicializada = true; valor = textoEntre(ini, getToken(0)); }
        )?

        {
            // DECORACION DEL NODO (ver DeclaracionVariable).
            jjtThis.decorarDeclaracion(id, tipo, inicializada, valor, dim);
        }

        PuntoYComaVirtual()
    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "Estructura inválida. Usa: ARREGLO Tipo Nombre[Tamaño]; o ARREGLO Tipo Nombre[Tamaño] = {valor1,valor2};"));
        recuperarHastaSync(SYNC_SENTENCIAS);
    }
}

// ==========================================
// DECLARACIÓN DE MATRICES
// Ejemplo: MATRIZ DEC Tablero[5][5];
// ==========================================
void DeclaracionMatriz() :
{
  Token id;
  String tipo = "?";
  Token ini = null;
  String dimFilas = "[]";
  String dimColumnas = "[]";
  boolean inicializada = false;
  String valor = "-";
}
{
    try {
        <MATRIZ_ESTRUCTURA> tipo = TipoDato()

        ( id = <VARIABLE> | id = <ERROR_IDENTIFICADOR_INVALIDO> )
        {
            if (id.kind == ERROR_IDENTIFICADOR_INVALIDO) {
                EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", id.beginLine, id.beginColumn,
                    "Identificador no valido '" + id.image + "'.",
                    "Toda variable debe iniciar con mayúscula seguido de minusculas o guiones bajos, no debe empezar con números. Ejemplo: 'Variable_1' o 'CONST_Mi_Nombre'"));
            }
        }

        // Las matrices requieren dos dimensiones
        <ABRIR_CORCHETE>
        { ini = getToken(1); }
        ExpresionAritmetica()
        { dimFilas = "[" + textoEntre(ini, getToken(0)) + "]"; }
        <CERRAR_CORCHETE>
        <ABRIR_CORCHETE>
        { ini = getToken(1); }
        ExpresionAritmetica()
        { dimColumnas = "[" + textoEntre(ini, getToken(0)) + "]"; }
        <CERRAR_CORCHETE>

        (
            <IGUAL_ASIGNACION>
            { ini = getToken(1); }
            <ABRIR_LLAVE>
                <ABRIR_LLAVE> Condicion() (<COMA> Condicion())* <CERRAR_LLAVE>
                ( <COMA> <ABRIR_LLAVE> Condicion() (<COMA> Condicion())* <CERRAR_LLAVE> )*
            <CERRAR_LLAVE>
            { inicializada = true; valor = textoEntre(ini, getToken(0)); }
        )?

        {
            // DECORACION DEL NODO (ver DeclaracionVariable).
            jjtThis.decorarDeclaracion(id, tipo, inicializada, valor, dimFilas + dimColumnas);
        }

        PuntoYComaVirtual()

    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "Estructura inválida. Usa: MATRIZ Tipo Nombre[Filas][Columnas];"));
        recuperarHastaSync(SYNC_SENTENCIAS);
    }
}

// ==========================================
// REGLA DE ASIGNACIÓN (Reasignar valores o Incrementar/Decrementar)
// ==========================================
void Asignacion() :
{
  Token id;
  Token op = null;      // el operador: "=", "++" o "--"
  int indices = 0;      // 0 escalar, 1 arreglo, 2 matriz
}
{
    try {
        ( id = <VARIABLE> | id = <CONSTANTE> | id = <ERROR_IDENTIFICADOR_INVALIDO> )
        {
          // Validamos qué fue lo que entró
            if (id.kind == ERROR_IDENTIFICADOR_INVALIDO) {
                EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", id.beginLine, id.beginColumn,
                    "Asignación incorrecta: Identificador no valido '" + id.image + "'.",
                    "Toda variable debe iniciar con mayúscula seguido de minusculas o guiones bajos, no debe empezar con números. Ejemplo: 'Variable_1' o 'CONST_Mi_Nombre'"));
          }
        }
        //Soporte opcional para acceder a índices de arreglos o matrices
        (
                    <ABRIR_CORCHETE> ExpresionAritmetica() <CERRAR_CORCHETE>
                    { indices = 1; }
                    ( <ABRIR_CORCHETE> ExpresionAritmetica() <CERRAR_CORCHETE> { indices = 2; } )? // El segundo es opcional (para matrices)
                )?

        // Puede ser una asignación (= 5) o un incremento/decremento (++)
        (
            ( op = <IGUAL_ASIGNACION> Condicion() )
          | op = <INCREMENTO_AL_VALOR>
          | op = <DECREMENTO_AL_VALOR>
        )

        // DECORACION DEL NODO: destino, operador y cuantos indices traia el
        // acceso. Con esto el analizador semantico distingue "X = e", "X++" y
        // "A[i] = e" sin tener que releer los tokens del nodo.
        { jjtThis.decorarAsignacion(id, op, indices); }
        PuntoYComaVirtual()

    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);

        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "Asegúrate de asignar un valor válido y terminar con un punto y coma."));
        recuperarHastaSync(SYNC_SENTENCIAS);
    }
}


/*
  Gramatica para la impresión
*/

// Regla para lo que va dentro del IMPRIMIR y LEER ("texto" + variable)
void ExpresionConcatenada() :
{ Token op; }
{
    ExpresionAritmetica() ( op = <SUMA> { jjtThis.agregarOperador(op); } ExpresionAritmetica() )*
}

// ==========================================
// ENTRADA Y SALIDA (Con recuperación de errores)
// ==========================================

void Imprimir() :
{}
{
    try {
        <IMPRIMIR_FUNCION> <ABRIR_PARENTESIS> ExpresionConcatenada() <CERRAR_PARENTESIS> PuntoYComaVirtual()
    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "Asegúrate de usar la estructura IMPRIMIR(valor); o IMPRIMIR(\"Mensaje\" + Variable); "));
        recuperarHastaSync(SYNC_SENTENCIAS);
    }
}

void Leer() :
{}
{
    try {
        <LEER_FUNCION> <ABRIR_PARENTESIS> ExpresionConcatenada() <CERRAR_PARENTESIS> PuntoYComaVirtual()
    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "La estructura correcta es LEER(Variable); o LEER(\"Mensaje\" + Variable);"));
        recuperarHastaSync(SYNC_SENTENCIAS);
    }
}

// Operadores Relacionales
void OperadorRelacional() :
{ Token t; }
{
    ( t = <MAYOR> | t = <MENOR> | t = <IGUAL_COMPARACION> | t = <DIFERENTE> | t = <MAYOR_IGUAL> | t = <MENOR_IGUAL> )
    // DECORACION: el nodo se queda con su propio operador, asi CondicionSimple
    // lo encuentra mirando a este hijo en vez de rebuscar entre los tokens.
    { jjtThis.tokenId = t; }
}

// Una condición simple: Variable > 5
// ==========================================
// CONDICIÓN SIMPLE (Ej. Numero > 5, VERDADERO, o !!EsEstudiante)
// ==========================================
void CondicionSimple() :
{ Token neg = null; Token err = null; }
{
    // 1. Opcional: Puede iniciar con la negación lógica (!!) o el error (!)
    (
        neg = <NO_LOGICO>
          | err = <ERROR_NEGACION_INCOMPLETA>
             {
                   EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", err.beginLine, err.beginColumn,
                      "Operador de negación incompleto: '" + err.image + "'",
                      "Para negar una condición en EasyScript debes usar '!!'."));
        }
    )?
    // DECORACION: hubo negacion logica. El '!' incompleto cuenta igual: el error
    // lexico ya se reporto, pero el arbol debe reflejar lo que se quiso escribir.
    { jjtThis.negado = (neg != null || err != null); }

    // 2. La expresión principal a evaluar
    ExpresionAritmetica()

    // 3. Opcional: Operador relacional y segundo valor (Ej. > 5)
    ( OperadorRelacional() ExpresionAritmetica() )?
}

// ==========================================
// CONDICIÓN COMPUESTA (Une múltiples CondicionSimple con && o ||)
// ==========================================
void Condicion() :
{ Token op = null; }
{
    // Siempre debe haber al menos una condición simple
    CondicionSimple()

    // Cero o más veces, puede estar unida a otra por medio de AND / OR
    (
        // Leemos el operador (&&, ||) o el error de escribir solo (&, |)
        (
            op = <Y_LOGICO>
          | op = <O_LOGICO>
          | op = <ERROR_LOGICO_INCOMPLETO>
            {
                // Atrapamos el '&' o '|' solitario en tiempo real
                EasyCompiler.listaErrores.add(new ErrorCompilador("Léxico", op.beginLine, op.beginColumn,
                    "Operador lógico incompleto: '" + op.image + "'",
                    "Asegúrate de usar operadores dobles: && para 'Y', || para 'O'."));
            }
        )
        // DECORACION: el operador logico de ESTA vuelta del bucle.
        //
        // Las tres alternativas escriben sobre la MISMA variable a proposito. Si
        // el error tuviera su propia variable, en la segunda vuelta seguiriamos
        // viendo el operador de la primera y anotariamos el equivocado.
        { jjtThis.agregarOperador(op); }
        // Y exigimos que después del operador venga otra condición
        CondicionSimple()
    )*
}

// ==========================================
// CONDICIONAL SI / CONTRARIO / SINO
// ==========================================
void CondicionalSi() :
{}
{
    try{
      <SI_CONDICIONAL> <ABRIR_PARENTESIS> Condicion() <CERRAR_PARENTESIS> <ABRIR_LLAVE>
              Sentencias()
           <CERRAR_LLAVE>

      // El CONTRARIO (Else If) es opcional y puede repetirse (*)
          ( LOOKAHEAD(1)
              <SI_CONTRARIO> <ABRIR_PARENTESIS> Condicion() <CERRAR_PARENTESIS> <ABRIR_LLAVE>
                  Sentencias()
              <CERRAR_LLAVE>
          )*

          // El SINO (Else) es opcional y solo aparece una vez (?)
          ( LOOKAHEAD(1)
              <SI_SINO> <ABRIR_LLAVE>
                  Sentencias()
              <CERRAR_LLAVE>
          )?
    }catch(ParseException e){
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);

        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "Verifica que la condición lógica esté completa y encierra las sentencias entre { }."));
        // consumirPuntoYComa = false → nos detenemos en "}" sin consumirlo
        // para no romper el bloque padre.
        recuperarHastaSync(SYNC_SENTENCIAS);
        if (getToken(1).kind == CERRAR_LLAVE) {
            getNextToken();
        }
  }
}


// ==========================================
// CONDICIONAL SEGUN (Switch)
// ==========================================
void CondicionalSegun() :
{ Token ctrl = null; }
{
    try{
    <SEGUN_CONDICIONAL> <ABRIR_PARENTESIS> ctrl = <VARIABLE> <CERRAR_PARENTESIS>
    // DECORACION: la variable de control del SEGUN. Hoy no se capturaba, y sin
    // ella no hay forma de comprobar que cada CASO sea de un tipo comparable.
    { jjtThis.tokenId = ctrl; }
    <ABRIR_LLAVE>

            // Debe haber al menos un CASO (+)
            (
                <CASO_SEGUN> Valor() <DOS_PUNTOS>
                    Sentencias()
                <DETENER_SEGUN> PuntoYComaVirtual()
            )+

            // El DEFECTO es opcional (?)
            (
                <DEFECTO_SEGUN> <DOS_PUNTOS>
                    Sentencias()
            )?

    <CERRAR_LLAVE>

    }catch(ParseException e){
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "El SEGUN requiere 'CASO valor:', finalizar cada caso con 'DETENER;' y cerrar llaves."));
        recuperarHastaSync(SYNC_SENTENCIAS);
        if (getToken(1).kind == CERRAR_LLAVE) {
            getNextToken();
        }
    }

}

// ==========================================
// BUCLE PARA
// ==========================================
void BuclePara() :
{ Token varPaso = null; Token opPaso = null; }
{
  try{
    <PARA_CICLO> <ABRIR_PARENTESIS>
          // 1. Declaración inicial (Ej. ENT i = 0;)
          DeclaracionVariable()

          // 2. Condición (Ej. i < 10)
          Condicion() <PUNTO_COMA>

          // 3. Incremento/Decremento (Asumiendo tokens como INCREMENTO para "++")
          varPaso = <VARIABLE> ( opPaso = <INCREMENTO_AL_VALOR> | opPaso = <DECREMENTO_AL_VALOR> )
          // DECORACION: el paso del ciclo. Se guarda porque el esquema de
          // traduccion lo necesita al final: sintacticamente va en la cabecera,
          // pero el cuadruplo que lo aplica se emite DESPUES del cuerpo.
          { jjtThis.tokenId = varPaso; jjtThis.agregarOperador(opPaso); }

    <CERRAR_PARENTESIS> <ABRIR_LLAVE>
          Sentencias()
    <CERRAR_LLAVE>
  }catch(ParseException e){
    int[] pos = obtenerPosicion(e);
    String detalleDinamico = obtenerDetalleSintactico(e);
    listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "El ciclo necesita 3 partes: Declaración ; Condición ; Incremento/Decremento."));
    recuperarHastaSync(SYNC_SENTENCIAS);
    if (getToken(1).kind == CERRAR_LLAVE) {
        getNextToken();
    }
  }

}

// ==========================================
// BUCLE MIENTRAS
// ==========================================
void BucleMientras() :
{}
{
    try {
        <MIENTRAS_CICLO> <ABRIR_PARENTESIS> Condicion() <CERRAR_PARENTESIS> <ABRIR_LLAVE>
            Sentencias()
        <CERRAR_LLAVE>
    } catch (ParseException e) {
        int[] pos = obtenerPosicion(e);
        String detalleDinamico = obtenerDetalleSintactico(e);
        listaErrores.add(new ErrorCompilador("Sintáctico", pos[0], pos[1],
            detalleDinamico,
            "El ciclo necesita la estructura: MIENTRAS ( Condicion ) { sentencias }."));

        // Falso para detenernos en la llave de cierre sin consumirla (protege el bloque padre)
        recuperarHastaSync(SYNC_SENTENCIAS);
        if (getToken(1).kind == CERRAR_LLAVE) {
            getNextToken();
        }
    }
}
